{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": { "1": "#C8F031", "2": "#EDEDE8" },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#8A8A84", "title": "#C8F031" },
    "key": { "width": 8 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[38;2;42;42;39m────────────────────────\u001b[0m" },
    { "type": "os",       "key": "os",     "format": "{pretty-name}" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "wm",       "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "shell",    "key": "shell" },
    { "type": "cpu",      "key": "cpu", "format": "{name}" },
    { "type": "gpu",      "key": "gpu", "format": "{name}" },
    { "type": "memory",   "key": "ram" },
    { "type": "disk",     "key": "disk", "folders": "/" },
    { "type": "battery",  "key": "bat" },
    { "type": "uptime",   "key": "up" },
    "break",
    { "type": "colors", "symbol": "square" }
  ]
}
