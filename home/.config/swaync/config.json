{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "control-center-margin-top": 6,
  "control-center-margin-bottom": 6,
  "control-center-margin-right": 6,
  "control-center-width": 380,
  "notification-window-width": 360,
  "notification-icon-size": 32,
  "notification-body-image-height": 120,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 120,
  "hide-on-clear": true,
  "hide-on-action": true,
  "widgets": ["title", "dnd", "mpris", "volume", "backlight", "notifications"],
  "widget-config": {
    "title": { "text": "NOTIFICAÇÕES", "clear-all-button": true, "button-text": "limpar" },
    "dnd": { "text": "Não perturbe" },
    "mpris": { "image-size": 48, "image-radius": 0 },
    "volume": { "label": "VOL" },
    "backlight": { "label": "BRILHO" }
  }
}
